# Copy to .env and fill in. .env is gitignored — never commit it.

# Registry login (Caddy basic_auth in front of registry.crest.internal).
REGISTRY_USER=
# Bcrypt hash of the password. Generate with:
#   docker run --rm -it caddy:2 caddy hash-password
# Keep the single quotes: the hash contains `$`, which Compose would
# otherwise try to interpolate.
REGISTRY_PASSWORD_HASH=''

# Jira reports (https://reports.crest.internal). Login is Caddy basic_auth, as for the registry.
JIRA_REPORTS_USER=
# Bcrypt hash, generated and quoted the same way as REGISTRY_PASSWORD_HASH.
JIRA_REPORTS_PASSWORD_HASH=''
# Atlassian account the token in services/jira-reports/secrets/jira_token belongs to.
JIRA_REPORTS_EMAIL=
# Optional: image tag to run (default latest), and the board whose active sprint is the default report.
# JIRA_REPORTS_TAG=
# JIRA_REPORTS_SPRINT_BOARD_ID=16
