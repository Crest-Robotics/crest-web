# Copy to .env and fill in. .env is gitignored — never commit it.

# Host directory holding the company root cert and Caddy's intermediate CA
# (root.crt, caddy-intermediate.crt, caddy-intermediate.key).
# See README "TLS certificates".
CADDY_PKI_DIR=/etc/crest-pki

# Registry login (Caddy basic_auth in front of registry.crest.internal).
REGISTRY_USER=
# Bcrypt hash of the password. Generate with:
#   docker run --rm -it caddy:2 caddy hash-password
# Keep the single quotes: the hash contains `$`, which Compose would
# otherwise try to interpolate.
REGISTRY_PASSWORD_HASH=''

# Host directory for registry blobs. Keep it on the USB SSD, not the SD card.
REGISTRY_DATA_DIR=/mnt/data/registry
